# ---- Backend ----
DATABASE_URL=postgresql://sports:sports@postgres:5432/sports
TZ=Asia/Seoul

# Deterministic demo seeding (set false once a live Naver feed is wired)
SEED_ENABLED=true

# Weather: synthetic (offline, deterministic) | openweather (needs key)
WEATHER_PROVIDER=synthetic
OPENWEATHER_API_KEY=

# Naver mobile endpoints
NAVER_BASE=https://m.sports.naver.com
NAVER_USER_AGENT=Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_TZ=Asia/Seoul
